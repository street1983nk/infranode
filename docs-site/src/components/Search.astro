---
// Eigene Such-UI (D-01, kein vorgefertigtes Pagefind-Default-UI). Lädt zur
// Laufzeit /pagefind/pagefind.js dynamisch (existiert erst nach postbuild),
// ruft pagefind.search(query) und rendert Treffer in eigenem Markup. Das
// Sucheingabe-Icon ist inline-SVG (CLAUDE.md: Icons als SVG, keine Emojis).
// Ergebnis-Titel/Excerpts kommen direkt von Pagefind als sub_result.excerpt
// (bereits sanitisiertes HTML mit <mark>); wir setzen Titel via textContent
// und Excerpt via die Pagefind-eigene markierte Ausgabe.
interface Props {
  // Sprache der Seite (de Standard). Steuert Placeholder/aria-label der Suche.
  lang?: "de" | "en";
}
const { lang = "de" } = Astro.props;
const isEn = lang === "en";
const searchLabel = isEn ? "Search docs" : "Doku durchsuchen";
// Lokalisierte Leerzustands-Texte (D-09): werden zur Laufzeit aus Daten-
// Attributen gelesen, damit das Skript sprachunabhängig bleibt.
const msgEmpty = isEn ? "No results for" : "Keine Treffer für";
const msgLoading = isEn ? "Search is still loading…" : "Suche lädt noch …";
// Für die Live-Ansage der Trefferzahl (role=status) und das Listbox-Label.
const msgCount = isEn ? "results" : "Treffer";
const listboxLabel = isEn ? "Search results" : "Suchergebnisse";
---

<div
  class="search"
  data-search
  data-msg-empty={msgEmpty}
  data-msg-loading={msgLoading}
  data-msg-count={msgCount}
>
  <div class="search__field">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="search"
      class="search__input"
      placeholder={searchLabel}
      aria-label={searchLabel}
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
      data-search-input
    />
    <kbd class="search__kbd" aria-hidden="true">/</kbd>
  </div>
  <!-- role=listbox setzt das Skript nur, solange echte Optionen drin stehen;
       Statusmeldungen (laedt/keine Treffer) sind keine listbox-Kinder. -->
  <div class="search__results" id="search-results" data-search-results aria-label={listboxLabel}></div>
  <div class="sr-only" data-search-status role="status"></div>
</div>

<script>
  // Pagefind-Typen sind zur Build-Zeit nicht vorhanden; lose typisieren.
  type PagefindSubResult = { title: string; url: string; excerpt: string };
  type PagefindResult = { data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string; sub_results?: PagefindSubResult[] }> };
  type Pagefind = { search: (q: string) => Promise<{ results: PagefindResult[] }> };

  const root = document.querySelector<HTMLElement>("[data-search]");
  if (root) {
    const input = root.querySelector<HTMLInputElement>("[data-search-input]")!;
    const out = root.querySelector<HTMLElement>("[data-search-results]")!;
    const status = root.querySelector<HTMLElement>("[data-search-status]")!;
    const msgEmpty = root.dataset.msgEmpty || "Keine Treffer für";
    const msgLoading = root.dataset.msgLoading || "Suche lädt noch …";
    const msgCount = root.dataset.msgCount || "Treffer";
    let pagefind: Pagefind | null = null;
    let loading = false;
    let timer: number | undefined;
    // Combobox-Zustand: Options-Links des offenen Popups + aktiver Index
    // (aria-activedescendant, Fokus bleibt im Input).
    let options: HTMLAnchorElement[] = [];
    let active = -1;

    function setExpanded(open: boolean): void {
      input.setAttribute("aria-expanded", open ? "true" : "false");
      if (!open) {
        input.removeAttribute("aria-activedescendant");
      }
    }

    function setActive(index: number): void {
      if (active >= 0 && options[active]) {
        options[active].setAttribute("aria-selected", "false");
      }
      active = index;
      if (active >= 0 && options[active]) {
        const option = options[active];
        option.setAttribute("aria-selected", "true");
        input.setAttribute("aria-activedescendant", option.id);
        option.scrollIntoView({ block: "nearest" });
      } else {
        input.removeAttribute("aria-activedescendant");
      }
    }

    async function ensurePagefind(): Promise<Pagefind | null> {
      if (pagefind || loading) return pagefind;
      loading = true;
      try {
        // /pagefind/pagefind.js existiert erst nach dem postbuild im dist und
        // ist zur Build-Zeit nicht auflösbar. Der Pfad wird zur Laufzeit
        // zusammengesetzt, damit Rollup ihn nicht statisch zu resolven
        // versucht (sonst bricht der Build mit "failed to resolve import").
        const path = ["", "pagefind", "pagefind.js"].join("/");
        const mod = await import(/* @vite-ignore */ path);
        pagefind = mod as unknown as Pagefind;
      } catch {
        pagefind = null;
      }
      loading = false;
      return pagefind;
    }

    function clear(): void {
      out.replaceChildren();
      out.removeAttribute("role");
      options = [];
      active = -1;
      setExpanded(false);
      status.textContent = "";
    }

    // Leerzustands-/Statusmeldung (D-09): reiner Text via textContent, damit der
    // Ergebnis-Container nicht leer ist (:empty-Regel greift dann nicht mehr).
    // Ohne Optionen traegt der Container KEIN role=listbox; die Meldung geht
    // zusaetzlich in die role=status-Live-Region.
    function showMsg(text: string): void {
      const p = document.createElement("p");
      p.className = "search__msg";
      p.textContent = text;
      out.removeAttribute("role");
      options = [];
      active = -1;
      out.replaceChildren(p);
      setExpanded(true);
      status.textContent = text;
    }

    async function run(query: string): Promise<void> {
      const q = query.trim();
      if (q.length < 2) {
        clear();
        return;
      }
      const pf = await ensurePagefind();
      if (!pf) {
        showMsg(msgLoading);
        return;
      }
      const search = await pf.search(q);
      clear();
      const top = search.results.slice(0, 8);
      if (top.length === 0) {
        showMsg(`${msgEmpty} „${q}“`);
        return;
      }
      const links: HTMLAnchorElement[] = [];
      for (const result of top) {
        const data = await result.data();
        const link = document.createElement("a");
        link.className = "search__result";
        link.href = data.url;
        link.id = `search-opt-${links.length}`;
        link.setAttribute("role", "option");
        link.setAttribute("aria-selected", "false");
        // Fokus bleibt im Combobox-Input (aria-activedescendant); die Options
        // haengen nicht in der Tab-Reihenfolge.
        link.tabIndex = -1;

        const title = document.createElement("span");
        title.className = "search__result-title";
        // Titel als reiner Text (textContent, kein innerHTML, T-12-XSS-Geist).
        title.textContent = data.meta.title || data.url;

        const excerpt = document.createElement("span");
        excerpt.className = "search__result-excerpt";
        // Pagefind liefert excerpt als markiertes (sanitisiertes) Snippet mit
        // <mark>; das ist Pagefind-eigene, nicht nutzergesteuerte Ausgabe.
        excerpt.innerHTML = data.excerpt;

        link.append(title, excerpt);
        links.push(link);
      }
      out.setAttribute("role", "listbox");
      out.replaceChildren(...links);
      options = links;
      active = -1;
      setExpanded(true);
      // Trefferzahl fuer Screenreader ansagen (aria-live, Befund 11-Muster).
      status.textContent = `${links.length} ${msgCount}`;
    }

    input.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        void run(input.value);
      }, 150);
    });

    // Combobox-Tastatursteuerung: Pfeiltasten bewegen die aktive Option
    // (aria-activedescendant), Enter oeffnet sie, der Fokus bleibt im Input.
    input.addEventListener("keydown", (e) => {
      if (options.length === 0) return;
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(active < options.length - 1 ? active + 1 : 0);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(active > 0 ? active - 1 : options.length - 1);
      } else if (e.key === "Enter" && active >= 0 && options[active]) {
        e.preventDefault();
        window.location.assign(options[active].href);
      }
    });

    // Klick ausserhalb der Suche schliesst das Popup (Combobox-Konvention).
    document.addEventListener("click", (e) => {
      if (e.target instanceof Node && !root.contains(e.target)) {
        clear();
      }
    });

    // Zurueck im Feld: Ergebnisse zur bestehenden Eingabe wieder anzeigen.
    input.addEventListener("focus", () => {
      if (out.childElementCount === 0 && input.value.trim().length >= 2) {
        void run(input.value);
      }
    });

    // Tastatur-Shortcut (Flexibilität für Power-User): "/" oder Cmd/Strg+K
    // fokussiert die Suche, greift nicht während man in einem Feld tippt.
    // Escape leert die Suche und verlässt das Feld; es greift ueberall
    // innerhalb der Such-Komponente, nicht nur im Input selbst.
    document.addEventListener("keydown", (e) => {
      const el = document.activeElement;
      const typing =
        el instanceof HTMLElement &&
        (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.isContentEditable);
      if ((e.key === "/" && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k")) {
        e.preventDefault();
        input.focus();
        input.select();
      } else if (e.key === "Escape" && el instanceof Node && root.contains(el)) {
        input.value = "";
        clear();
        input.blur();
      }
    });
  }
</script>
