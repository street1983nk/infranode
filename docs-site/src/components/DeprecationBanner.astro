---
// Hinweis auf abgekuendigte Feldnamen einer Operation. Rendert nichts, wenn die
// Operation nicht in FIELD_DEPRECATIONS steht, und steht auf der Endpunkt-Seite
// ganz oben.
//
// Gestaltung: KEIN generischer Warnkasten (Signalflaeche + Akzentkante links),
// sondern die Bildsprache dieser Doku. Zwei Anleihen:
//  1. Das Badge ist exakt das "Abkuendigung"-Badge der Changelog-Seite
//     (#8a4b00 auf #fbeede). Wer den Changelog kennt, erkennt hier dieselbe
//     Sache wieder; das Banner ist die endpunktlokale Instanz dieses Eintrags.
//  2. Die Umbenennungen stehen als kompakte Paare "alt -> neu" in der
//     Mono-Schrift, die die Doku fuer technische Werte ohnehin verwendet: der
//     alte Name durchgestrichen und zurueckgenommen, der neue in Petrol.
// Flaeche und Rahmen kommen aus den Seiten-Tokens (--bg-soft/--border-strong),
// damit der Block ruhig bleibt und Farbe nur dort sitzt, wo sie Bedeutung
// traegt: im Badge und im neuen Namen.
import {
  FIELD_DEPRECATIONS,
  type DeprecatedField,
  type DeprecationEntry,
} from "../data/deprecations";

interface Props {
  operationId: string;
  lang?: "de" | "en";
}

const { operationId, lang = "de" } = Astro.props;
const entry: DeprecationEntry | undefined = FIELD_DEPRECATIONS[operationId];
const fields: DeprecatedField[] | undefined = entry?.fields;

// Entfernungsdatum je Eintrag formatiert (ISO -> lesbares Datum je Sprache).
const formatDate = (iso: string): string => {
  const [y, m, d] = iso.split("-").map(Number);
  const months =
    lang === "en"
      ? ["January", "February", "March", "April", "May", "June", "July",
         "August", "September", "October", "November", "December"]
      : ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli",
         "August", "September", "Oktober", "November", "Dezember"];
  return lang === "en" ? `${d} ${months[m - 1]} ${y}` : `${d}. ${months[m - 1]} ${y}`;
};

const t =
  lang === "en"
    ? {
        badge: "Deprecated",
        title: "These fields have new names",
        lead: "The old names keep returning the same value and disappear no earlier than",
        replaced: "replaced by",
        foot: "Details in the",
        changelog: "/en/changelog/",
        changelogLabel: "changelog",
        and: "and on the",
        roadmap: "/en/roadmap/",
        roadmapLabel: "roadmap",
      }
    : {
        badge: "Abkündigung",
        title: "Diese Felder heißen jetzt anders",
        lead: "Die alten Namen liefern weiterhin denselben Wert und verschwinden frühestens am",
        replaced: "ersetzt durch",
        foot: "Details im",
        changelog: "/changelog/",
        changelogLabel: "Changelog",
        and: "und auf der",
        roadmap: "/roadmap/",
        roadmapLabel: "Roadmap",
      };
const removal = entry ? formatDate(entry.removal) : "";
---

{
  fields && fields.length > 0 && (
    <aside class="depr" role="note" aria-label={t.title}>
      <p class="depr__head">
        <span class="depr__badge">{t.badge}</span>
        <span class="depr__title">{t.title}</span>
      </p>
      <p class="depr__lead">
        {t.lead}{" "}
        <strong class="depr__date">{removal}</strong>.
      </p>
      <ul class="depr__diff">
        {fields.map((f) => (
          <li class="depr__row">
            <code class="depr__old">{f.old}</code>
            <span class="depr__sr">{t.replaced}</span>
            <span class="depr__arrow" aria-hidden="true">
              →
            </span>
            <code class="depr__new">{f.now}</code>
          </li>
        ))}
      </ul>
      <p class="depr__foot">
        {t.foot}{" "}
        <a href={t.changelog}>{t.changelogLabel}</a>{" "}
        {t.and}{" "}
        <a href={t.roadmap}>{t.roadmapLabel}</a>.
      </p>
    </aside>
  )
}

<style>
  .depr {
    margin: 0 0 1.75rem;
    padding: 1rem 1.15rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  .depr__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.7rem;
    margin: 0 0 0.35rem;
  }
  /* Identisch zum Changelog-Badge data-kind="deprecated". */
  .depr__badge {
    flex: none;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--warn-border);
    background: var(--warn-bg);
    color: var(--warn-fg);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .depr__title {
    font-weight: 600;
  }
  .depr__lead {
    margin: 0 0 0.9rem;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .depr__date {
    color: var(--fg);
    white-space: nowrap;
  }
  /* Umbenennungen als kompakte Paare "alt -> neu" in der Mono-Schrift, die die
     Doku fuer technische Werte verwendet. Sie fliessen nebeneinander und
     brechen um, statt in einem Raster mit Luecken zu stehen. */
  .depr__diff {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.75rem;
    margin: 0 0 0.9rem;
    padding: 0;
    list-style: none;
  }
  .depr__row {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--mono);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .depr__arrow {
    color: var(--fg-muted);
  }
  .depr__old {
    color: var(--fg-muted);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    overflow-wrap: anywhere;
  }
  .depr__new {
    color: var(--color-primary-strong);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  /* Ohne den globalen Chip-Hintergrund fuer <code>: der Block ist schon eine
     eigene Flaeche, ein zweiter Kasten je Name waere Unruhe. */
  .depr__old,
  .depr__new {
    background: none;
    border: 0;
    padding: 0;
  }
  .depr__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .depr__foot {
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
</style>
