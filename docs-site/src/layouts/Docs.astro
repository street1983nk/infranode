---
// Drei-Spalten-Doku-Layout (D-01/D-02): links Nav (endpoints-Collection nach
// tag gruppiert + Quick-Start/Start), Mitte Content-Slot (in data-pagefind-body
// für Pagefind, Pitfall 4), rechts "On this page" (clientseitig aus den
// Headings des Slots). Pagefind-Suche im Topbar via Search-Komponente.
import { getCollection } from "astro:content";
import Search from "../components/Search.astro";
import SeoHead from "../components/SeoHead.astro";
import PageActions from "../components/PageActions.astro";
import { CATEGORIES, CATEGORY_OF } from "../data/endpoint-categories";
import { NAV_LABEL, NAV_HIDDEN, NAV_LIVE } from "../data/endpoint-labels";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: string;
  // Sprache der Seite (de Standard). Steuert <html lang>, Nav-/Footer-Texte
  // und den Sprach-Switcher.
  lang?: "de" | "en";
  // Pfad der jeweils anderen Sprachfassung (für Switcher + hreflang). Leer,
  // wenn es kein Pendant gibt.
  altLangPath?: string;
  // An SeoHead durchgereicht: robots noindex (z.B. 404-Seite).
  noindex?: boolean;
}

const {
  title,
  description = "",
  current = "",
  lang = "de",
  altLangPath = "",
  noindex = false,
} = Astro.props;
const isEn = lang === "en";

// Nicht-Endpunkt-Seiten (Start, Quick-Start, MCP, Impressum, Datenschutz,
// Über, sowie deren EN-Pendants) bekommen keine Page-Actions. Endpunkt-Seiten
// tragen die operationId als `current`.
const NON_ENDPOINT = new Set([
  "",
  "home",
  "quickstart",
  "staedte",
  "cities",
  "abdeckung",
  "coverage",
  "mcp",
  "chatgpt",
  "gpts",
  "über",
  "impressum",
  "datenschutz",
  "tutorials",
  "tutorial",
  "daten",
  "changelog",
  "roadmap",
]);
// Per-Datentyp- ("daten-<id>") und per-City-Landingpages ("stadt-<slug>") sind
// keine Endpunkt-Seiten und tragen keine Page-Actions (kein .md-Pendant).
const isEndpointPage =
  !NON_ENDPOINT.has(current) &&
  !current.startsWith("daten-") &&
  !current.startsWith("stadt-") &&
  !current.startsWith("mcp-");
const mdUrl = isEndpointPage ? `/api/${current}.md` : "";
const actionPrompt = isEndpointPage
  ? isEn
    ? `Here is the InfraNode API documentation for ${title} in Markdown format. Help me use this endpoint. Docs URL:`
    : `Hier ist die InfraNode-API-Doku für ${title} im Markdown-Format. Hilf mir, diesen Endpunkt zu nutzen. Doku-URL:`
  : "";

// API-Referenz: EIN Baum für alle Endpunkte (Stadt + Live) je Themenkategorie.
// Live-Operationen (OpenAPI-Tag "Live") tragen ein LIVE-Badge statt einer
// eigenen Sektion. Als Link-Text dient das kurze kuratierte Label
// (endpoint-labels, Fallback summary); operationId + volle summary stehen im
// title-Attribut. Deprecation-Aliasse (NAV_HIDDEN) erscheinen nicht in der
// Sidebar, ihre Seiten existieren weiter.
type NavEndpoint = { id: string; method: string; label: string; title: string; live: boolean };
const endpoints = await getCollection("endpoints");
const byCat = new Map<string, NavEndpoint[]>();
for (const entry of endpoints) {
  if (NAV_HIDDEN.has(entry.data.id)) continue;
  const cat = CATEGORY_OF[entry.data.id] ?? "sonstige";
  if (!byCat.has(cat)) byCat.set(cat, []);
  const summary = (isEn ? entry.data.summaryEn : entry.data.summary) || entry.data.id;
  byCat.get(cat)!.push({
    id: entry.data.id,
    method: entry.data.method,
    label: NAV_LABEL[entry.data.id]?.[isEn ? "en" : "de"] ?? summary,
    title: `${entry.data.id}: ${summary}`,
    // LIVE-Badge = Echtzeitdaten: /live/-Routen (Tag) plus kuratierte
    // Stadt-Endpunkte mit Echtzeit-Charakter (NAV_LIVE, z.B. Spritpreise).
    live: entry.data.tag === "Live" || NAV_LIVE.has(entry.data.id),
  });
}
for (const list of byCat.values()) {
  list.sort((a, b) => a.label.localeCompare(b.label, lang));
}
const refTotal = [...byCat.values()].reduce((n, l) => n + l.length, 0);
const refActive = [...byCat.values()].some((l) => l.some((ep) => ep.id === current));

// Sidebar-Gruppen (aufgabenorientiert): Loslegen, Grundlagen, [API-Referenz],
// KI & Integrationen, Projekt. DE und EN kommen aus EINER Struktur, damit die
// Sprachfassungen nicht auseinanderlaufen. keys = current-Werte der Zielseiten
// (DE/EN), prefix markiert zugehörige Unterseiten (z.B. daten-<topic>).
type NavItem = {
  de: string;
  en: string;
  deHref: string;
  enHref: string;
  keys: string[];
  prefix?: string;
  cta?: boolean;
};
type NavGroup = { de: string; en: string; items: NavItem[] };
const NAV_PRE: NavGroup[] = [
  {
    de: "Loslegen",
    en: "Get started",
    items: [
      { de: "Quick-Start", en: "Quickstart", deHref: "/quickstart/", enHref: "/en/quickstart/", keys: ["quickstart"], cta: true },
      { de: "Tutorials", en: "Tutorials", deHref: "/tutorials/", enHref: "/en/tutorials/", keys: ["tutorials", "tutorial"] },
    ],
  },
  {
    de: "Grundlagen",
    en: "Basics",
    items: [
      { de: "Datenarten", en: "Data types", deHref: "/daten/", enHref: "/en/data/", keys: ["daten"], prefix: "daten-" },
      { de: "Paginierung & Limits", en: "Pagination & limits", deHref: "/pagination/", enHref: "/en/pagination/", keys: ["pagination"] },
      { de: "Städte", en: "Cities", deHref: "/staedte/", enHref: "/en/cities/", keys: ["staedte", "cities"], prefix: "stadt-" },
      { de: "Abdeckung & Status", en: "Coverage & status", deHref: "/abdeckung/", enHref: "/en/coverage/", keys: ["abdeckung", "coverage"] },
    ],
  },
];
const NAV_POST: NavGroup[] = [
  {
    de: "KI & Integrationen",
    en: "AI & integrations",
    items: [
      { de: "MCP-Server", en: "MCP server", deHref: "/mcp/", enHref: "/en/mcp/", keys: ["mcp"], prefix: "mcp-" },
      { de: "ChatGPT & GPTs", en: "ChatGPT & GPTs", deHref: "/chatgpt/", enHref: "/en/chatgpt/", keys: ["chatgpt", "gpts"] },
    ],
  },
  {
    de: "Projekt",
    en: "Project",
    items: [
      { de: "Changelog", en: "Changelog", deHref: "/changelog/", enHref: "/en/changelog/", keys: ["changelog"] },
      { de: "Roadmap", en: "Roadmap", deHref: "/roadmap/", enHref: "/en/roadmap/", keys: ["roadmap"] },
      { de: "Über", en: "About", deHref: "/ueber/", enHref: "/en/about/", keys: ["über"] },
    ],
  },
];
const itemActive = (item: NavItem) =>
  item.keys.includes(current) || (item.prefix ? current.startsWith(item.prefix) : false);
const groupActive = (group: NavGroup) => group.items.some(itemActive);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} lang={lang} altLangPath={altLangPath} noindex={noindex} />
    <slot name="jsonld" />
  </head>
  <body>
    <a class="skip-link" href="#main">{isEn ? "Skip to content" : "Zum Inhalt springen"}</a>
    <header class="topbar">
      <a class="topbar__brand" href={isEn ? "/en/" : "/"} aria-label={isEn ? "InfraNode home" : "InfraNode Startseite"}>
        <img
          class="topbar__logo"
          src="/logo-infranode.png"
          alt="InfraNode"
          width="68"
          height="64"
        />
        <span class="topbar__wordmark">InfraNode<span class="topbar__wordmark-tld">.dev</span></span>
      </a>
      <Search lang={lang} />
      <button
        class="topbar__menu"
        data-nav-toggle
        hidden
        aria-expanded="false"
        aria-controls="docs-nav"
        aria-label={isEn ? "Open menu" : "Menü öffnen"}
      >
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path class="topbar__menu-open" d="M3 5h14M3 10h14M3 15h14" />
          <path class="topbar__menu-close" d="M5 5l10 10M15 5L5 15" />
        </svg>
      </button>
      <nav class="langswitch" aria-label={isEn ? "Language" : "Sprache"}>
        <a
          class="langswitch__link"
          href={isEn ? altLangPath || "/" : "/"}
          aria-current={!isEn ? "true" : undefined}
          hreflang="de"
          lang="de">DE</a
        >
        <span class="langswitch__sep" aria-hidden="true">|</span>
        <a
          class="langswitch__link"
          href={isEn ? "/en/" : altLangPath || "/en/"}
          aria-current={isEn ? "true" : undefined}
          hreflang="en"
          lang="en">EN</a
        >
      </nav>
    </header>

    {
      /* Als aside eine eigene Landmark, damit der Banner nicht ausserhalb
         aller Landmarks haengt (WCAG 1.3.1 / Landmark-Vollstaendigkeit). */
      current !== "mcp" && (
        <aside aria-label={isEn ? "MCP server note" : "MCP-Server-Hinweis"}>
          <a class="mcphint" href={isEn ? "/en/mcp/" : "/mcp/"}>
            <span class="mcphint__badge">MCP</span>
            <span class="mcphint__text">
              {isEn
                ? "InfraNode is also available as an MCP server for AI assistants like Claude and ChatGPT."
                : "InfraNode gibt es auch als MCP-Server für KI-Assistenten wie Claude und ChatGPT."}
            </span>
            <span class="mcphint__arrow" aria-hidden="true">→</span>
          </a>
        </aside>
      )
    }

    <div class="layout">
      <nav class="nav" id="docs-nav" aria-label={isEn ? "Documentation navigation" : "Doku-Navigation"}>
        <details class="nav__disclosure" open>
          <summary class="nav__toggle">{isEn ? "Menu" : "Menü"}</summary>
          <div class="nav__inner">
        {
          NAV_PRE.map((group) => (
            <details class="nav__grp" open data-active={groupActive(group) ? "" : undefined}>
              <summary class="nav__grp-title"><span class="nav__grp-label">{isEn ? group.en : group.de}</span></summary>
              <ul class="nav__list">
                {group.items.map((item) => (
                  <li>
                    <a
                      class={item.cta ? "nav__link nav__link--cta" : "nav__link"}
                      href={isEn ? item.enHref : item.deHref}
                      aria-current={itemActive(item) ? "page" : undefined}
                    >
                      {isEn ? item.en : item.de}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
        <details class="nav__grp nav__grp--ref" open data-active={refActive ? "" : undefined}>
          <summary class="nav__grp-title">
            <span class="nav__grp-label">{isEn ? "API reference" : "API-Referenz"}</span>
            <span class="nav__cat-count">{refTotal}</span>
          </summary>
          {
            CATEGORIES.filter((cat) => byCat.has(cat.id)).map((cat) => (
              <details class="nav__cat" open={byCat.get(cat.id)!.some((ep) => ep.id === current)}>
                <summary class="nav__cat-title">
                  {isEn ? cat.en : cat.de}
                  <span class="nav__cat-count">{byCat.get(cat.id)!.length}</span>
                </summary>
                <ul class="nav__list">
                  {byCat.get(cat.id)!.map((ep) => (
                    <li>
                      <a
                        class="nav__link nav__link--ep"
                        href={isEn ? `/en/api/${ep.id}/` : `/api/${ep.id}/`}
                        aria-current={current === ep.id ? "page" : undefined}
                        title={ep.title}
                      >
                        <span class="nav__ep-label">{ep.label}</span>
                        {ep.live && <span class="nav__live">LIVE</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
        </details>
        {
          NAV_POST.map((group) => (
            <details class="nav__grp" open data-active={groupActive(group) ? "" : undefined}>
              <summary class="nav__grp-title"><span class="nav__grp-label">{isEn ? group.en : group.de}</span></summary>
              <ul class="nav__list">
                {group.items.map((item) => (
                  <li>
                    <a
                      class={item.cta ? "nav__link nav__link--cta" : "nav__link"}
                      href={isEn ? item.enHref : item.deHref}
                      aria-current={itemActive(item) ? "page" : undefined}
                    >
                      {isEn ? item.en : item.de}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))
        }
          </div>
        </details>
      </nav>

      {/* tabindex=-1: Skip-Link-Ziel programmatisch fokussierbar (Safari). */}
      <main class="content" id="main" tabindex="-1">
        {isEndpointPage && <PageActions mdUrl={mdUrl} prompt={actionPrompt} lang={lang} />}
        <article data-pagefind-body data-content-root>
          <slot />
        </article>
      </main>

      <aside class="toc" aria-label={isEn ? "On this page" : "Auf dieser Seite"}>
        <p class="toc__title">{isEn ? "On this page" : "Auf dieser Seite"}</p>
        <ul class="toc__list" data-toc></ul>
      </aside>
    </div>

    <footer class="footer">
      <div class="footer__inner">
        <p class="footer__brand">InfraNode</p>
        {
          isEn ? (
            <nav class="footer__nav" aria-label="Footer">
              <a class="footer__link" href="/en/">Home</a>
              <a class="footer__link" href="/en/quickstart/">Quickstart</a>
              <a class="footer__link" href="/en/cities/">Cities</a>
              <a class="footer__link" href="/en/mcp/">MCP server</a>
              <a class="footer__link" href="/en/mcp-comparison/">MCP comparison</a>
              <a class="footer__link" href="/en/changelog/">Changelog</a>
              <a class="footer__link" href="/en/roadmap/">Roadmap</a>
              <a class="footer__link" href="/en/about/">About</a>
              <a class="footer__link" href="/en/imprint/">Imprint</a>
              <a class="footer__link" href="/en/privacy/">Privacy</a>
            </nav>
          ) : (
            <nav class="footer__nav" aria-label="Footer">
              <a class="footer__link" href="/quickstart/">Quick-Start</a>
              <a class="footer__link" href="/staedte/">Städte</a>
              <a class="footer__link" href="/mcp/">MCP-Server</a>
              <a class="footer__link" href="/mcp-vergleich/">MCP-Vergleich</a>
              <a class="footer__link" href="/changelog/">Changelog</a>
              <a class="footer__link" href="/roadmap/">Roadmap</a>
              <a class="footer__link" href="/ueber/">Über</a>
              <a class="footer__link" href="/impressum/">Impressum</a>
              <a class="footer__link" href="/datenschutz/">Datenschutz</a>
            </nav>
          )
        }
        <p class="footer__meta">
          {
            isEn
              ? "Free, no ads, accessible. Operated on servers in Germany and Finland (EU). Source code on GitHub (Apache-2.0)."
              : "Kostenlos, ohne Werbung, barrierefrei. Betrieb auf Servern in Deutschland und Finnland (EU). Quellcode öffentlich auf GitHub (Apache-2.0)."
          }
        </p>
      </div>
    </footer>

    <script>
      // "On this page" clientseitig aus den h2-Headings des Content-Slots.
      const root = document.querySelector<HTMLElement>("[data-content-root]");
      const tocList = document.querySelector<HTMLElement>("[data-toc]");
      if (root && tocList) {
        const headings = root.querySelectorAll<HTMLHeadingElement>("h2");
        let index = 0;
        for (const heading of headings) {
          if (!heading.id) {
            heading.id = `section-${index}`;
          }
          index += 1;
          const li = document.createElement("li");
          const link = document.createElement("a");
          link.className = "toc__link";
          link.href = `#${heading.id}`;
          link.textContent = heading.textContent;
          li.append(link);
          tocList.append(li);
        }
      }

      // Scrollbare Code-/Antwort-Bereiche per Tastatur erreichbar machen
      // (WCAG 2.1.1): tabindex=0, wo noch keins gesetzt ist (die
      // CodeTabs-Panels bringen ihres statisch mit).
      for (const el of document.querySelectorAll<HTMLElement>("pre, .tryit__out")) {
        if (!el.hasAttribute("tabindex")) el.setAttribute("tabindex", "0");
      }

      // Content-Tabellen (alle ausser .cov, die haben ein eigenes Mobil-Layout)
      // in einen scrollenden Wrapper mit role=region + tabindex=0 heben. Ersetzt
      // das display:block auf der Tabelle (zerstoert die Tabellensemantik in
      // WebKit/VoiceOver) und macht den Scrollbereich tastaturerreichbar.
      const isEnPage = document.documentElement.lang === "en";
      for (const table of document.querySelectorAll<HTMLTableElement>(".content table:not(.cov)")) {
        const wrap = document.createElement("div");
        wrap.className = "table-scroll";
        wrap.setAttribute("role", "region");
        wrap.setAttribute("tabindex", "0");
        const caption = table.querySelector("caption")?.textContent?.trim();
        wrap.setAttribute("aria-label", caption || (isEnPage ? "Table" : "Tabelle"));
        table.replaceWith(wrap);
        wrap.append(table);
      }

      // Links mit target=_blank: Screenreader-Hinweis "oeffnet neues Fenster"
      // ergaenzen (WCAG 3.2.5-Best-Practice). rel=noopener ist ueberall gesetzt;
      // ein vorhandenes aria-label (z.B. GPT-Karten) gewinnt ohnehin.
      const newWindowHint = isEnPage ? " (opens in a new window)" : " (öffnet neues Fenster)";
      for (const link of document.querySelectorAll<HTMLAnchorElement>('a[target="_blank"]')) {
        const hint = document.createElement("span");
        hint.className = "sr-only";
        hint.textContent = newWindowHint;
        link.append(hint);
      }

      // Mobiles Navigationsmenü: mit JS wird das <details> zum Overlay-Drawer,
      // geöffnet über den Hamburger in der Topbar. Die Nav-Gruppen starten im
      // Drawer geschlossen, nur die Gruppe der aktuellen Seite ist offen. Auf
      // Desktop bleibt alles offen. Ohne JS bleibt das Inline-<details> mit
      // sichtbarem "Menü"-Toggle erhalten (html.js steuert die CSS-Umschaltung).
      document.documentElement.classList.add("js");
      const navDisclosure = document.querySelector<HTMLDetailsElement>(".nav__disclosure");
      const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const topbar = document.querySelector<HTMLElement>(".topbar");
      const navGroups = document.querySelectorAll<HTMLDetailsElement>(".nav__grp");
      if (navDisclosure && navToggle && topbar) {
        const navMq = window.matchMedia("(max-width: 1080px)");
        // Hintergrund des offenen Drawers: diese Bereiche werden inert, damit
        // Tab und Screenreader nicht hinter das Overlay geraten (WCAG 2.4.3).
        const inertTargets = [".mcphint", "main", ".toc", ".footer"]
          .map((sel) => document.querySelector<HTMLElement>(sel))
          .filter((el): el is HTMLElement => el !== null);
        const setTopbarHeight = () => {
          document.documentElement.style.setProperty("--topbar-h", `${topbar.offsetHeight}px`);
        };
        const syncToggle = () => {
          navToggle.setAttribute("aria-expanded", String(navDisclosure.open));
          const drawerOpen = navMq.matches && navDisclosure.open;
          // Drawer offen -> Seite dahinter nicht scrollen (nur mobil relevant).
          document.body.classList.toggle("nav-open", drawerOpen);
          for (const el of inertTargets) {
            el.inert = drawerOpen;
          }
        };
        const applyNavState = () => {
          setTopbarHeight();
          navDisclosure.open = !navMq.matches;
          // Mobil: Gruppen geschlossen, aktive Gruppe offen. Desktop: alle offen.
          for (const grp of navGroups) {
            grp.open = navMq.matches ? grp.hasAttribute("data-active") : true;
          }
          syncToggle();
        };
        navToggle.hidden = false;
        navToggle.addEventListener("click", () => {
          navDisclosure.open = !navDisclosure.open;
          syncToggle();
        });
        navDisclosure.addEventListener("toggle", syncToggle);
        // Escape schliesst den offenen Drawer und gibt den Fokus an den
        // Hamburger zurueck (WAI-ARIA-Dialog-Konvention).
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && navMq.matches && navDisclosure.open) {
            navDisclosure.open = false;
            syncToggle();
            navToggle.focus();
          }
        });
        window.addEventListener("resize", setTopbarHeight);
        applyNavState();
        navMq.addEventListener("change", applyNavState);
      }
    </script>
  </body>
</html>
