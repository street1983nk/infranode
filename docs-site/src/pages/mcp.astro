// die 67 Datenarten nach Thema gruppiert. Quelle der Einrichtungs-Snippets
// ist docs/mcp-install.md.
import Docs from "../layouts/Docs.astro";
import CodeTabs from "../components/CodeTabs.astro";
import JsonLd from "../components/JsonLd.astro";
import { mcpTopics } from "../data/mcp-topics";

// Einrichtungs-Snippets. Der Server ist öffentlich gehostet (Remote, Streamable
