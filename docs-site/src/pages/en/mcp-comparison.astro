const sources = [
  ["germany-mcp-server", "https://github.com/AiAgentKarl/germany-mcp-server"],
  ["db-mcp-server", "https://github.com/PaulvonBerg/db-mcp-server"],
  ["mcp-server-public-transport", "https://github.com/mirodn/mcp-server-public-transport"],
